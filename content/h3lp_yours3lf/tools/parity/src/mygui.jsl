--!strict
-- MyGUI's skins and layouts as data. Every value is the one the XML declares: an attribute keeps
-- its own name, coordinates become numbers, and properties and user strings stay in file order
-- as { key, value } pairs. Nothing is resolved here. MyGUI applies alignment and skin offsets at
-- run time, against the parent's size, so whoever reads these values does that arithmetic.

local luaData = require './luaData'
local xml = require './xml'

type Element = xml.Element
export type Table = luaData.Table

export type MetricsSource = { build: string, commit: string, path: string, repository: string }

local Coordinates = { offset = true, position = true, position_real = true, size = true }

local Groups = {
  BasisSkin = 'basis',
  Child = 'children',
  Property = 'properties',
  State = 'states',
  UserString = 'userStrings',
  Widget = 'widgets',
}

local Pairs = { Property = true, UserString = true }

-- The layout editor's code generator settings. They describe no widget.
local EditorOnly = { CodeGeneratorSettings = true }

local Mygui = {}

local function coordinates(fileName: string, element: Element, name: string, text: string): Table
  local values: Table = {}
  for word in string.gmatch(text, '%S+') do
    local value = tonumber(word)
    if not value then
      error(`{fileName}:{element.line}: {name}="{text}" is not a list of numbers`, 0)
    end

    values[#values + 1] = value
  end

  return values
end

local function convert(fileName: string, element: Element): Table
  local record: Table = {}
  for name, text in element.attributes do
    record[name] = if Coordinates[name] then coordinates(fileName, element, name, text) else text
  end

  for _, child in element.children do
    if EditorOnly[child.name] then continue end

    local group = Groups[child.name]
    if not group then error(`{fileName}:{child.line}: unexpected <{child.name}>`, 0) end

    local list = (record[group] or {}) :: Table
    record[group] = list

    if not Pairs[child.name] then
      list[#list + 1] = convert(fileName, child)
      continue
    end

    local key, value = child.attributes.key, child.attributes.value
    if not key or not value or #child.children > 0 then
      error(`{fileName}:{child.line}: <{child.name}> needs key and value, and nothing inside`, 0)
    end

    list[#list + 1] = { key, value } :: Table
  end

  return record
end

local function root(fileName: string, text: string, kind: string): Element
  local document = xml.parse(text, fileName)
  if document.name ~= 'MyGUI' or document.attributes.type ~= kind then
    error(`{fileName}: expected <MyGUI type="{kind}">`, 0)
  end

  return document
end

--- Adds the skins `text` declares, from the file `fileName`, to `skins`.
function Mygui.addSkins(skins: Table, fileName: string, text: string)
  for _, resource in root(fileName, text, 'Resource').children do
    if resource.name ~= 'Resource' then
      error(`{fileName}:{resource.line}: unexpected <{resource.name}>`, 0)
    end

    local record = convert(fileName, resource)
    local name = record.name
    if type(name) ~= 'string' then error(`{fileName}:{resource.line}: a resource needs a name`, 0) end

    local earlier = skins[name]
    if earlier then
      error(`{fileName}:{resource.line}: {name} is already declared in {(earlier :: Table).file}`, 0)
    end

    record.name = nil
    record.file = fileName
    skins[name] = record
  end
end

--- The layout `text` declares, from the file `fileName`.
function Mygui.layout(fileName: string, text: string): Table
  local document = root(fileName, text, 'Layout')
  local record = convert(fileName, document)
  record.type = nil
  record.file = fileName

  return record
end

--- The metrics module for `skins` and `layouts`, read from `source`.
function Mygui.metricsModule(skins: Table, layouts: Table, source: MetricsSource): string
  local metrics = {
    layouts = layouts,
    skins = skins,
    source = {
      build = source.build,
      commit = source.commit,
      path = source.path,
      repository = source.repository,
    },
  }

  local header = {
    "Vanilla UI metrics: every skin and layout in OpenMW's files/data/mygui, as declared.",
    `Source: {source.repository} at {source.commit}`,
    `Build: {source.build}`,
    'Generated by content/h3lp_yours3lf/tools/parity (extract). Do not edit; extract again.',
  }

  return luaData.write(metrics, { 'omw-context none' }, header)
end

--- A layout's name: its file name without `openmw_` and `.layout`, as #11 and the manifest use.
function Mygui.layoutName(fileName: string): string?
  return string.match(fileName, '^openmw_(.+)%.layout$')
end

return Mygui
