--!strict
-- What the suites share: where this package is.

local Support = {}

--- This package's folder, from this file's chunk name: `jess package test` runs a suite from
--- whatever folder it was called in.
function Support.packageRoot(): string
  local source = debug.info(1, 's')
  local first = string.sub(source, 1, 1)
  local path = if first == '@' or first == '=' then string.sub(source, 2) else source

  return string.match(path, '^(.*)/tests/[^/]*$') or '.'
end

return Support
