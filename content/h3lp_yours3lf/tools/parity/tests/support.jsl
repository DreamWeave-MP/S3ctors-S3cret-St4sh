--!strict
-- What the suites share: where this package is, and the H3 data modules beside it.

local files = require '@h3uiparity/files'
local fs = require '@dream/fs'
local luaData = require '@h3uiparity/luadata'

local Support = {}

--- This package's folder, from this file's chunk name: `jess package test` runs a suite from
--- whatever folder it was called in.
function Support.packageRoot(): string
  local source = debug.info(1, 's')
  local first = string.sub(source, 1, 1)
  local path = if first == '@' or first == '=' then string.sub(source, 2) else source

  return string.match(path, '^(.*)/tests/[^/]*$') or '.'
end

--- The path of the H3 module `name`, such as 'parity/manifest', under scripts/h3.
function Support.h3Path(name: string): string
  return fs.join(Support.packageRoot(), `../../scripts/h3/{name}.lua`)
end

--- The table the H3 data module `name` returns.
function Support.h3Data(name: string): luaData.Table
  local path = Support.h3Path(name)

  return luaData.read(files.readText(path), path)
end

return Support
