uniform_int uDebugMode {
    default = 0;
    min = 0;
    max = 7;
    step = 1;
    display_name = "#{S3Shaders:WaterDebugModeName}";
    description = "#{S3Shaders:WaterDebugModeDesc}";
    static = true;
}

uniform_float uWaveScale {
    default = 0.0025;
    min = 0.0001;
    max = 0.05;
    step = 0.0001;
    display_name = "#{S3Shaders:WaterWaveScaleName}";
    description = "#{S3Shaders:WaterWaveScaleDesc}";
    static = true;
}

uniform_float uWaveSpeed {
    default = 0.025;
    min = 0.0;
    max = 0.2;
    step = 0.001;
    display_name = "#{S3Shaders:WaterWaveSpeedName}";
    description = "#{S3Shaders:WaterWaveSpeedDesc}";
    static = true;
}

uniform_float uDistortionStrength {
    default = 0.003;
    min = 0.0;
    max = 0.02;
    step = 0.0001;
    display_name = "#{S3Shaders:WaterDistortionName}";
    description = "#{S3Shaders:WaterDistortionDesc}";
    static = true;
}

uniform_vec3 uWaterTint {
    default = vec3(0.04, 0.12, 0.16);
    display_name = "#{S3Shaders:WaterTintName}";
    description = "#{S3Shaders:WaterTintDesc}";
    static = true;
}

uniform_float uMaxWaterDepth {
    default = 512.0;
    min = 1.0;
    max = 4096.0;
    step = 1.0;
    display_name = "#{S3Shaders:WaterMaxDepthName}";
    description = "#{S3Shaders:WaterMaxDepthDesc}";
    static = true;
}

uniform_float uReflectionStrength {
    default = 0.35;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "#{S3Shaders:WaterReflectionName}";
    description = "#{S3Shaders:WaterReflectionDesc}";
    static = true;
}

uniform_float uWaterWorldTolerance {
    default = 2.0;
    min = 0.01;
    max = 50.0;
    step = 0.1;
    display_name = "#{S3Shaders:WaterWorldToleranceName}";
    description = "#{S3Shaders:WaterWorldToleranceDesc}";
    static = true;
}

fragment water {
    void main() {
        vec2 uv = gl_FragCoord.xy / omw.resolution;

        if (!omw.isWaterEnabled)
        {
            omw_FragColor = omw_GetLastShader(uv);
            return;
        }

        if (omw.isUnderwater)
        {
            vec3 sceneColor = omw_GetLastShader(uv).rgb;

            float linearDepth = omw_GetLinearDepth(uv);

            float depthFade = clamp(
                linearDepth / uMaxWaterDepth,
                0.0,
                1.0
            );

            vec3 underwaterColor = mix(
                sceneColor,
                uWaterTint * 0.5,
                depthFade
            );

            omw_FragColor = vec4(underwaterColor, 1.0);
            return;
        }

        // --------------------------------------------------------
        // Water mask: reconstruct world position from depth and
        // compare against waterHeight in world-space Z.
        //
        // OpenMW's water surface (with refraction on, the default)
        // renders in the opaque bin with depth writes enabled, so
        // the depth buffer contains the water surface depth.
        //
        // World-space comparison is numerically stable (no NDC
        // precision issues, handles reverse-Z internally).
        //
        // We do a cheap ray-plane intersection first to get waterPos
        // for later shading, and also as a quick reject for pixels
        // that are looking away from the water plane (sky).
        // --------------------------------------------------------

        vec2 ndc = uv * 2.0 - 1.0;

        vec4 farView = omw.invProjectionMatrix
            * vec4(ndc, 1.0, 1.0);

        farView /= farView.w;

        vec3 ray = normalize(
            (omw.invViewMatrix
                * vec4(farView.xyz, 0.0)).xyz
        );

        float t = (
            omw.waterHeight - omw.eyePos.z
        ) / ray.z;

        // Quick reject: ray pointing away from water plane
        if (t <= 0.0)
        {
            omw_FragColor = omw_GetLastShader(uv);
            return;
        }

        vec3 waterPos = omw.eyePos.xyz + ray * t;

        // Reconstruct scene world position from depth and compare
        //
        // Classify a pixel as water by comparing the distance along
        // the view ray to the scene geometry vs. to the water plane.
        //
        //   t = distance to water plane intersection
        //   tScene = distance to visible scene geometry
        //
        //   If t < tScene: water plane is in front of scene geometry
        //     → pixel is underwater → apply water effect
        //
        //   If t > tScene: scene geometry is in front of water plane
        //     → pixel is above water → passthrough
        //
        //   If t ≈ tScene: shoreline edge → soft blend
        //
        // This works whether or not the water surface writes depth:
        //   - Water writes depth → tScene ≈ t at water surface
        //   - No water depth → tScene > t for underwater terrain
        //
        // Either way, pixels below the waterline get the effect.
        // --------------------------------------------------------

        vec3 sceneWorldPos = omw_GetWorldPosFromUV(uv);

        float tScene = length(sceneWorldPos - omw.eyePos.xyz);

        float tDiff = tScene - t;  // positive = underwater

        float waterMask = smoothstep(
            -uWaterWorldTolerance,
            uWaterWorldTolerance,
            tDiff
        );

        // --------------------------------------------------------
        // Debug: water mask
        // --------------------------------------------------------

        if (uDebugMode == 1)
        {
            omw_FragColor = vec4(vec3(waterMask), 1.0);
            return;
        }

        // --------------------------------------------------------
        // Non-water fast path
        // --------------------------------------------------------

        if (waterMask <= 0.001)
        {
            omw_FragColor = omw_GetLastShader(uv);
            return;
        }

        // --------------------------------------------------------
        // Debug: water world position
        // (waterPos already computed above for the water mask)
        // --------------------------------------------------------

        if (uDebugMode == 2)
        {
            omw_FragColor = vec4(
                fract(waterPos * 0.01),
                1.0
            );
            return;
        }

        // --------------------------------------------------------
        // Water depth (distance from water surface to scene geometry)
        // sceneWorldPos was already computed above for the water mask
        // --------------------------------------------------------

        float waterDepth = max(
            0.0,
            omw.waterHeight - sceneWorldPos.z
        );

        float depthFactor = clamp(
            waterDepth / uMaxWaterDepth,
            0.0,
            1.0
        );

        if (uDebugMode == 4)
        {
            omw_FragColor = vec4(vec3(depthFactor), 1.0);
            return;
        }

        // --------------------------------------------------------
        // Procedural water normal from world-space coordinates
        // Two octaves of sine waves, world-locked, camera-independent
        // --------------------------------------------------------

        vec2 p = waterPos.xy * uWaveScale;

        float time = omw.simulationTime * uWaveSpeed;

        float waveX = sin(
            p.x * 6.2831853
            + time
            + sin(p.y * 3.0)
        );

        float waveY = sin(
            p.y * 6.2831853
            - time * 1.37
            + sin(p.x * 2.0)
        );

        vec3 waterNormal = normalize(
            vec3(waveX, waveY, 1.0)
        );

        if (uDebugMode == 5)
        {
            omw_FragColor = vec4(
                waterNormal * 0.5 + 0.5,
                1.0
            );
            return;
        }

        // --------------------------------------------------------
        // View direction
        // --------------------------------------------------------

        vec3 viewDir = normalize(
            omw.eyePos.xyz - waterPos
        );

        // --------------------------------------------------------
        // Refraction
        // Screen-space distortion from water normal, one scene sample
        // --------------------------------------------------------

        vec2 refractedUV = uv
            + waterNormal.xy
            * uDistortionStrength;

        refractedUV = clamp(
            refractedUV,
            vec2(0.0),
            vec2(1.0)
        );

        vec3 refractedColor = omw_GetLastShader(refractedUV).rgb;

        if (uDebugMode == 6)
        {
            omw_FragColor = vec4(refractedColor, 1.0);
            return;
        }

        // --------------------------------------------------------
        // Depth-aware refraction rejection
        // Sample depth at the refracted UV and compare against
        // the water-plane depth to reject foreground pulls.
        // --------------------------------------------------------

        vec4 waterClip = omw.projectionMatrix
            * (omw.viewMatrix
                * vec4(waterPos, 1.0));

        float waterNDCZ = waterClip.z / waterClip.w;

        float refractedDepth = omw_GetDepth(refractedUV);
#if (OMW_REVERSE_Z == 1)
        float refractedNDCZ = 1.0 - refractedDepth;
#else
        float refractedNDCZ = refractedDepth * 2.0 - 1.0;
#endif

        if (refractedNDCZ > waterNDCZ + 0.001)
        {
            refractedColor = omw_GetLastShader(uv).rgb;
        }

        // --------------------------------------------------------
        // Cheap pseudo-reflection
        // Reflect view direction around water normal, approximate
        // screen-space offset, one scene-color sample
        // --------------------------------------------------------

        vec3 reflectDir = reflect(
            -viewDir,
            waterNormal
        );

        vec2 reflectOffset = reflectDir.xy
            * uDistortionStrength
            * 2.0;

        vec2 reflectedUV = clamp(
            uv + reflectOffset,
            vec2(0.0),
            vec2(1.0)
        );

        vec3 reflectedColor = omw_GetLastShader(reflectedUV).rgb;

        // --------------------------------------------------------
        // Fresnel (x^5 polynomial approximation)
        // --------------------------------------------------------

        float fresnel = 1.0 - clamp(
            dot(viewDir, waterNormal),
            0.0,
            1.0
        );

        float fresnel2 = fresnel * fresnel;
        float fresnel4 = fresnel2 * fresnel2;
        fresnel = fresnel4 * fresnel;

        // --------------------------------------------------------
        // Blend: refraction + reflection via Fresnel
        // --------------------------------------------------------

        vec3 waterColor = mix(
            refractedColor,
            reflectedColor,
            fresnel * uReflectionStrength
        );

        // --------------------------------------------------------
        // Depth-based water tint
        // --------------------------------------------------------

        waterColor = mix(
            waterColor,
            uWaterTint,
            depthFactor * 0.75
        );

        // --------------------------------------------------------
        // Blend with original scene at water mask edges
        // --------------------------------------------------------

        vec3 sceneColor = omw_GetLastShader(uv).rgb;

        vec3 finalColor = mix(
            sceneColor,
            waterColor,
            waterMask
        );

        omw_FragColor = vec4(finalColor, 1.0);
    }
}

technique {
    author = "S3ctor";
    description = "Faest water shader";
    passes = water;
    version = "0.2";
}
