uniform_int uDebugMode {
    default = 0;
    min = 0;
    max = 7;
    step = 1;
    display_name = "#{S3Shaders:WaterDebugModeName}";
    description = "#{S3Shaders:WaterDebugModeDesc}";
    static = true;
}

uniform_float uWaveScale {
    default = 0.0025;
    min = 0.0001;
    max = 0.05;
    step = 0.0001;
    display_name = "#{S3Shaders:WaterWaveScaleName}";
    description = "#{S3Shaders:WaterWaveScaleDesc}";
    static = true;
}

uniform_float uWaveSpeed {
    default = 0.025;
    min = 0.0;
    max = 0.2;
    step = 0.001;
    display_name = "#{S3Shaders:WaterWaveSpeedName}";
    description = "#{S3Shaders:WaterWaveSpeedDesc}";
    static = true;
}

uniform_float uDistortionStrength {
    default = 0.003;
    min = 0.0;
    max = 0.02;
    step = 0.0001;
    display_name = "#{S3Shaders:WaterDistortionName}";
    description = "#{S3Shaders:WaterDistortionDesc}";
    static = true;
}

uniform_vec3 uWaterTint {
    default = vec3(0.04, 0.12, 0.16);
    display_name = "#{S3Shaders:WaterTintName}";
    description = "#{S3Shaders:WaterTintDesc}";
    static = true;
}

uniform_float uMaxWaterDepth {
    default = 512.0;
    min = 1.0;
    max = 4096.0;
    step = 1.0;
    display_name = "#{S3Shaders:WaterMaxDepthName}";
    description = "#{S3Shaders:WaterMaxDepthDesc}";
    static = true;
}

uniform_float uReflectionStrength {
    default = 0.35;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "#{S3Shaders:WaterReflectionName}";
    description = "#{S3Shaders:WaterReflectionDesc}";
    static = true;
}

uniform_float uWaterWorldTolerance {
    default = 2.0;
    min = 0.01;
    max = 50.0;
    step = 0.1;
    display_name = "#{S3Shaders:WaterWorldToleranceName}";
    description = "#{S3Shaders:WaterWorldToleranceDesc}";
    static = true;
}

fragment water {
    void main() {
        vec2 uv = gl_FragCoord.xy / omw.resolution;

        // --------------------------------------------------------
        // Early out: water disabled
        // --------------------------------------------------------

        if (!omw.isWaterEnabled)
        {
            omw_FragColor = omw_GetLastShader(uv);
            return;
        }

        // --------------------------------------------------------
        // Underwater path
        // --------------------------------------------------------

        if (omw.isUnderwater)
        {
            vec3 sceneColor = omw_GetLastShader(uv).rgb;

            float linearDepth = omw_GetLinearDepth(uv);

            float depthFade = clamp(
                linearDepth / uMaxWaterDepth,
                0.0,
                1.0
            );

            vec3 underwaterColor = mix(
                sceneColor,
                uWaterTint * 0.5,
                depthFade
            );

            omw_FragColor = vec4(underwaterColor, 1.0);
            return;
        }

        // --------------------------------------------------------
        // World-space ray reconstruction
        //
        // Use an UNNORMALIZED ray direction. The plane intersection
        // formula P = eye + ray * ((H - eye.z) / ray.z) is invariant
        // under scaling of ray — the scale cancels in the division.
        // This avoids a rsqrt + multiply per pixel.
        // --------------------------------------------------------

        vec2 ndc = uv * 2.0 - 1.0;

        vec4 farView = omw.invProjectionMatrix
            * vec4(ndc, 1.0, 1.0);

        farView /= farView.w;

        vec3 ray = (
            omw.invViewMatrix
                * vec4(farView.xyz, 0.0)
        ).xyz;

        float t = (
            omw.waterHeight - omw.eyePos.z
        ) / ray.z;

        // Quick reject: ray pointing away from water plane
        if (t <= 0.0)
        {
            omw_FragColor = omw_GetLastShader(uv);
            return;
        }

        vec3 waterPos = omw.eyePos.xyz + ray * t;

        // --------------------------------------------------------
        // Cache scene color — one texture fetch, reused everywhere
        // --------------------------------------------------------

        vec3 sceneColor = omw_GetLastShader(uv).rgb;

        // --------------------------------------------------------
        // Water mask: derive scene depth from linear depth + ray
        //
        // Both sceneWorldPos and waterPos lie on the same view ray.
        // The difference along the ray is:
        //
        //   tDiff = tScene - t
        //
        // Instead of omw_GetWorldPosFromUV(uv) (1 depth tex + 2
        // mat4×vec4 + 1 perspective divide), we derive tScene from
        // omw_GetLinearDepth(uv) and the existing ray. The z
        // component of the ray in view space (rayViewZ) relates
        // linear depth to the ray parameter tScene:
        //
        //   rayViewZ = (viewMatrix * vec4(ray, 0)).z
        //   tScene = -linearDepth / rayViewZ     (camera at view origin, looking down -Z)
        //   tDiff = tScene - t
        //
        // This eliminates 2 mat4×vec4 multiplies and 1 perspective
        // divide per pixel, replacing them with ~8 scalar ops.
        //
        //   tDiff > 0: scene is behind water plane → water effect
        //   tDiff < 0: scene is in front of water plane → passthrough
        // --------------------------------------------------------

        float linearDepth = omw_GetLinearDepth(uv);

        float rayViewZ = (
            omw.viewMatrix[0].z * ray.x
            + omw.viewMatrix[1].z * ray.y
            + omw.viewMatrix[2].z * ray.z
        );

        float tScene = -linearDepth / rayViewZ;
        float tDiff = tScene - t;

        float sceneWorldPosZ = omw.eyePos.z + ray.z * tScene;

        float waterMask = smoothstep(
            -uWaterWorldTolerance,
            uWaterWorldTolerance,
            tDiff
        );

        // --------------------------------------------------------
        // Debug: water mask
        // --------------------------------------------------------

        if (uDebugMode == 1)
        {
            omw_FragColor = vec4(vec3(waterMask), 1.0);
            return;
        }

        // --------------------------------------------------------
        // Non-water fast path
        // --------------------------------------------------------

        if (waterMask <= 0.001)
        {
            omw_FragColor = vec4(sceneColor, 1.0);
            return;
        }

        // --------------------------------------------------------
        // Debug: water world position
        // --------------------------------------------------------

        if (uDebugMode == 2)
        {
            omw_FragColor = vec4(
                fract(waterPos * 0.01),
                1.0
            );
            return;
        }

        // --------------------------------------------------------
        // Water depth (distance from water surface to scene geometry)
        // --------------------------------------------------------

        float waterDepth = max(
            0.0,
            omw.waterHeight - sceneWorldPosZ
        );

        float depthFactor = clamp(
            waterDepth / uMaxWaterDepth,
            0.0,
            1.0
        );

        if (uDebugMode == 4)
        {
            omw_FragColor = vec4(vec3(depthFactor), 1.0);
            return;
        }

        // --------------------------------------------------------
        // Procedural water normal from world-space coordinates
        // --------------------------------------------------------

        vec2 p = waterPos.xy * uWaveScale;

        float time = omw.simulationTime * uWaveSpeed;

        float waveX = sin(
            p.x * 6.2831853
            + time
            + sin(p.y * 3.0)
        );

        float waveY = sin(
            p.y * 6.2831853
            - time * 1.37
            + sin(p.x * 2.0)
        );

        vec3 waterNormal = normalize(
            vec3(waveX, waveY, 1.0)
        );

        if (uDebugMode == 5)
        {
            omw_FragColor = vec4(
                waterNormal * 0.5 + 0.5,
                1.0
            );
            return;
        }

        // --------------------------------------------------------
        // View direction
        // --------------------------------------------------------

        vec3 viewDir = normalize(-ray);

        // --------------------------------------------------------
        // Refraction
        // Screen-space distortion from water normal
        // No explicit UV clamping needed — omw_SamplerLastShader
        // uses CLAMP_TO_EDGE (confirmed in postprocessor.cpp:457)
        // --------------------------------------------------------

        vec2 refractedUV = uv
            + waterNormal.xy
            * uDistortionStrength;

        vec3 refractedColor = omw_GetLastShader(refractedUV).rgb;

        if (uDebugMode == 6)
        {
            omw_FragColor = vec4(refractedColor, 1.0);
            return;
        }

        // --------------------------------------------------------
        // Depth-aware refraction rejection
        //
        // If the refracted sample is CLOSER than the water surface,
        // it's foreground geometry (e.g. a tree branch overhanging
        // the water). Reject by falling back to the cached scene
        // color at the original UV.
        //
        // Using omw_GetLinearDepth for a Z-convention-independent
        // comparison — correct for both standard and reverse-Z.
        // --------------------------------------------------------

        float refractedLinearDepth = omw_GetLinearDepth(refractedUV);
        float waterLinearDepth = linearDepth;

        if (refractedLinearDepth < waterLinearDepth - 0.5)
        {
            refractedColor = sceneColor;
        }

        // --------------------------------------------------------
        // Cheap pseudo-reflection
        // Reflect view direction around water normal, approximate
        // screen-space offset, one scene-color sample
        // --------------------------------------------------------

        vec3 reflectDir = reflect(
            -viewDir,
            waterNormal
        );

        vec2 reflectOffset = reflectDir.xy
            * uDistortionStrength
            * 2.0;

        vec2 reflectedUV = uv + reflectOffset;

        vec3 reflectedColor = omw_GetLastShader(reflectedUV).rgb;

        // --------------------------------------------------------
        // Fresnel (x^5 polynomial approximation)
        // --------------------------------------------------------

        float fresnel = 1.0 - clamp(
            dot(viewDir, waterNormal),
            0.0,
            1.0
        );

        float fresnel2 = fresnel * fresnel;
        float fresnel4 = fresnel2 * fresnel2;
        fresnel = fresnel4 * fresnel;

        // --------------------------------------------------------
        // Blend: refraction + reflection via Fresnel
        // --------------------------------------------------------

        vec3 waterColor = mix(
            refractedColor,
            reflectedColor,
            fresnel * uReflectionStrength
        );

        // --------------------------------------------------------
        // Depth-based water tint
        // --------------------------------------------------------

        waterColor = mix(
            waterColor,
            uWaterTint,
            depthFactor * 0.75
        );

        // --------------------------------------------------------
        // Blend with cached scene color at mask edges
        // --------------------------------------------------------

        vec3 finalColor = mix(
            sceneColor,
            waterColor,
            waterMask
        );

        omw_FragColor = vec4(finalColor, 1.0);
    }
}

technique {
    author = "S3ctor";
    description = "Faest water shader";
    passes = water;
    version = "0.2";
}
