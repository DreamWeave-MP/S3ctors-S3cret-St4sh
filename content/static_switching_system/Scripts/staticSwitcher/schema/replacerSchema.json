{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Static Switcher Module",
    "type": "object",
    "definitions": {
        "recordId": {
            "type": "string"
        },
        "numericRange": {
            "oneOf": [
                {
                    "type": "number",
                    "description": "Fixed numeric value"
                },
                {
                    "type": "object",
                    "properties": {
                        "min": {
                            "type": "number",
                            "description": "Optional minimum value"
                        },
                        "max": {
                            "type": "number",
                            "description": "Required maximum value"
                        }
                    },
                    "required": [
                        "max"
                    ],
                    "additionalProperties": false,
                    "description": "Random range with optional lower bound"
                }
            ]
        },
        "chanceRange": {
            "oneOf": [
                {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Fixed chance from 0 to 1."
                },
                {
                    "type": "object",
                    "properties": {
                        "min": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Optional minimum chance; defaults to 0."
                        },
                        "max": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Required maximum chance."
                        }
                    },
                    "required": [
                        "max"
                    ],
                    "additionalProperties": false,
                    "description": "Randomly selected chance range."
                }
            ]
        },
        "vector3Range": {
            "type": "object",
            "properties": {
                "x": {
                    "$ref": "#/definitions/numericRange"
                },
                "y": {
                    "$ref": "#/definitions/numericRange"
                },
                "z": {
                    "$ref": "#/definitions/numericRange"
                }
            },
            "additionalProperties": false
        },
        "exteriorGrid": {
            "type": "object",
            "properties": {
                "x": {
                    "type": "integer"
                },
                "y": {
                    "type": "integer"
                }
            },
            "required": [
                "x",
                "y"
            ],
            "additionalProperties": false
        },
        "replacementMap": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "string"
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "replaceAction": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "itemAction": {
            "oneOf": [
                {
                    "$ref": "#/definitions/recordId",
                    "description": "A record ID to apply with a count of one."
                },
                {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "oneOf": [
                                {
                                    "type": "integer",
                                    "minimum": 1,
                                    "description": "Fixed item count with an implicit 100% chance."
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                    "count": {
                                        "oneOf": [
                                            {
                                                "type": "integer",
                                                "minimum": 1,
                                                "description": "Fixed item count."
                                            },
                                            {
                                                "type": "object",
                                                "properties": {
                                                    "min": {
                                                        "type": "integer",
                                                        "minimum": 1,
                                                        "description": "Minimum count (defaults to 1)."
                                                    },
                                                    "max": {
                                                        "type": "integer",
                                                        "minimum": 1,
                                                        "description": "Required maximum count."
                                                    }
                                                },
                                                "required": ["max"],
                                                "additionalProperties": false,
                                                "description": "Random count range."
                                            }
                                        ],
                                        "default": 1,
                                        "description": "Number of items to apply, or a random range."
                                    },
                                        "chance": {
                                            "$ref": "#/definitions/chanceRange",
                                            "description": "Chance to apply this item entry."
                                        }
                                    },
                                    "anyOf": [
                                        {
                                            "required": [
                                                "count"
                                            ]
                                        },
                                        {
                                            "required": [
                                                "chance"
                                            ]
                                        }
                                    ],
                                    "additionalProperties": false,
                                    "description": "Item count and optional chance roll."
                                }
                            ]
                        }
                    },
                    "minProperties": 1,
                    "additionalProperties": false,
                    "description": "Record IDs mapped to counts."
                }
            ]
        },
        "transformAction": {
            "type": "object",
            "properties": {
                "scale": {
                    "$ref": "#/definitions/numericRange"
                },
                "rotate": {
                    "$ref": "#/definitions/vector3Range"
                },
                "position": {
                    "$ref": "#/definitions/vector3Range"
                },
                "transform_type": {
                    "type": "string",
                    "enum": [
                        "relative",
                        "absolute"
                    ],
                    "default": "relative",
                    "description": "Whether transformations should be applied relative to existing values (default) or as absolute replacements"
                }
            },
            "additionalProperties": false
        },
        "createPool": {
            "type": "object",
            "properties": {
                "count": {
                    "oneOf": [
                        {"type": "integer", "minimum": 1, "description": "Fixed number of objects."},
                        {
                            "type": "object",
                            "properties": {
                                "min": {"type": "integer", "minimum": 1},
                                "max": {"type": "integer", "minimum": 1}
                            },
                            "required": ["max"],
                            "additionalProperties": false,
                            "description": "Random count range."
                        }
                    ],
                    "default": 1,
                    "description": "Number of objects to spawn from this pool, or a random range."
                },
                "chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Probability (0-1) that this pool activates."
                },
                "scale": {
                    "$ref": "#/definitions/numericRange"
                },
                "rotate": {
                    "$ref": "#/definitions/vector3Range"
                },
                "position": {
                    "$ref": "#/definitions/vector3Range"
                },
                "transform_type": {
                    "type": "string",
                    "enum": ["relative", "absolute"],
                    "default": "relative",
                    "description": "Whether position/rotation/scale overrides are relative to the trigger object's values (default) or absolute."
                }
            },
            "additionalProperties": false
        },
        "createAction": {
            "type": "object",
            "description": "Map of record IDs to spawn details. Each pool is evaluated independently (unlike replace, which picks one winner). Values can be a bare record ID (spawn 1), an integer count, or a full create pool config with chance and transform overrides.",
            "patternProperties": {
                "^.*$": {
                    "oneOf": [
                        {"type": "string", "description": "Spawn 1 copy at trigger position."},
                        {"type": "integer", "minimum": 1, "description": "Spawn this many copies at trigger position."},
                        {"$ref": "#/definitions/createPool"}
                    ]
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "instanceAction": {
            "type": "object",
            "properties": {
                "replace": {
                    "$ref": "#/definitions/replaceAction"
                },
                "transform": {
                    "$ref": "#/definitions/transformAction"
                },
                "add": {
                    "$ref": "#/definitions/itemAction",
                    "description": "Queues one or more items to be added to the current action target's inventory when the target is an Actor or Container."
                },
                "remove": {
                    "$ref": "#/definitions/itemAction",
                    "description": "Removes one or more items from the current action target's inventory when the target is an Actor or Container and the requested count is available."
                },
                "equip": {
                    "$ref": "#/definitions/itemAction",
                    "description": "Queues forced OpenMW UseItem for one or more items on the current action target when the target is an Actor, creating and moving the requested count into inventory first when missing. Equippable items equip; consumables or usable items may be consumed/used by OpenMW."
                },
                "unequip": {
                    "$ref": "#/definitions/itemAction",
                    "description": "Queues forced OpenMW UseItem for one or more currently equipped matching items on the current action target when the target is an Actor. The requested count must already be equipped; missing items are not created."
                },
                "disable": {
                    "oneOf": [
                        {
                            "const": true
                        },
                        {
                            "type": "object",
                            "properties": {
                                "chance": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1,
                                    "description": "Probability from 0 to 1 that this action applies."
                                }
                            },
                            "additionalProperties": false
                        }
                    ],
                    "description": "Disable the action target after any replacement or transform actions in this rule. If paired with replace, this disables the replacement. When an object with chance is given instead of true, the action applies only when the random roll succeeds."
                },
                "delete": {
                    "const": true,
                    "description": "Queue removal of the matched source object after any replacement or transform actions in this rule. If paired in the same action table with replace, removal is queued only when that replacement succeeds."
                },
                "create": {
                    "$ref": "#/definitions/createAction",
                    "description": "Spawn objects at the trigger's position. Each pool (record ID) is evaluated independently with optional count, chance, and position/rotation/scale overrides per pool. Transform overrides within a pool re-randomize per object for scatter/spread effects."
                }
            },
            "anyOf": [
                {
                    "required": [
                        "replace"
                    ]
                },
                {
                    "required": [
                        "transform"
                    ]
                },
                {
                    "required": [
                        "add"
                    ]
                },
                {
                    "required": [
                        "remove"
                    ]
                },
                {
                    "required": [
                        "equip"
                    ]
                },
                {
                    "required": [
                        "unequip"
                    ]
                },
                {
                    "required": [
                        "disable"
                    ]
                },
                {
                    "required": [
                        "delete"
                    ]
                },
                {
                    "required": [
                        "create"
                    ]
                }
            ],
            "additionalProperties": false
        },
        "carryingCount": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "carryingCondition": {
            "oneOf": [
                {
                    "$ref": "#/definitions/recordId"
                },
                {
                    "$ref": "#/definitions/carryingCount"
                }
            ]
        },
        "stringOrStringList": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                }
            ]
        },
        "numberOrNumberList": {
            "oneOf": [
                {
                    "type": "number"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "number"
                    },
                    "minItems": 1
                }
            ]
        },
        "exteriorGridList": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/exteriorGrid"
            },
            "minItems": 1,
            "description": "One or more exterior grid coordinates. This must be an array because table-valued condition payloads are treated as OR-lists by the loader."
        },
        "carryingConditionValue": {
            "oneOf": [
                {
                    "$ref": "#/definitions/recordId"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/carryingCondition"
                    },
                    "minItems": 1
                }
            ]
        },
        "conditionData": {
            "type": "object",
            "properties": {
                "carrying": {
                    "$ref": "#/definitions/carryingConditionValue"
                },
                "cell": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "cell_match": {
                    "$ref": "#/definitions/stringOrStringList",
                    "description": "Case-insensitive substring match against the object's cell name or cell ID."
                },
                "coords": {
                    "$ref": "#/definitions/exteriorGridList"
                },
                "content_file": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "exterior": {
                    "type": "boolean"
                },
                "quasi_exterior": {
                    "type": "boolean"
                },
                "nameMatch": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "not": {
                    "$ref": "#/definitions/conditionData",
                    "description": "Invert a single inner condition. The value is a condition table like {nameMatch: \"Guard\"} — the inner condition is evaluated and the result negated."
                },
                "has_journal": {
                    "type": "object",
                    "properties": {
                        "quest": {
                            "type": "string",
                            "description": "Quest ID to check the journal index of."
                        },
                        "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Shorthand for min. Stage >= index."
                        },
                        "min": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Minimum journal stage, inclusive."
                        },
                        "max": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Maximum journal stage, inclusive."
                        }
                    },
                    "required": [
                        "quest"
                    ],
                    "anyOf": [
                        {
                            "required": [
                                "index"
                            ]
                        },
                        {
                            "required": [
                                "min"
                            ]
                        },
                        {
                            "required": [
                                "max"
                            ]
                        }
                    ],
                    "additionalProperties": false,
                    "description": "Check whether the player's journal stage for a quest is within the given range. At least one of index/min/max is required."
                },
                "has_name": {
                    "type": "boolean"
                },
                "player_level": {
                    "oneOf": [
                        {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Player must be at least this level."
                        },
                        {
                            "type": "object",
                            "properties": {
                                "min": {"type": "integer", "minimum": 1},
                                "max": {"type": "integer", "minimum": 1}
                            },
                            "additionalProperties": false,
                            "description": "Player level range. At least one of min or max is required."
                        }
                    ],
                    "anyOf": [
                        {"required": ["min"]},
                        {"required": ["max"]}
                    ],
                    "description": "Gate by player level. Bare number means at-least."
                },
                "current_weather": {
                    "oneOf": [
                        {
                            "type": "string",
                            "description": "Case-insensitive substring match against the current weather name. The literal value \"none\" matches when no weather is active (interiors, transitions)."
                        },
                        {
                            "type": "array",
                            "items": {"type": "string"},
                            "minItems": 1,
                            "description": "Match any of the listed weather name substrings. Include \"none\" to match when no weather is active."
                        },
                        {
                            "type": "object",
                            "properties": {
                                "isStorm": {"type": "boolean"},
                                "name": {"type": "string"}
                            },
                            "additionalProperties": false,
                            "description": "Match by storm flag and/or weather name substring. At least one of isStorm or name is required; when both are present both must match."
                        }
                    ],
                    "anyOf": [
                        {"required": ["isStorm"]},
                        {"required": ["name"]}
                    ],
                    "description": "Gate by current weather in the player's cell."
                },
                "mesh": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "object_type": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "record_id": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "content_file_target": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            },
                            "minItems": 1
                        }
                    },
                    "minProperties": 1,
                    "additionalProperties": false,
                    "description": "Map of content file names to reference numbers within that file. The object must originate from the specified content file AND have a matching reference number. All keyed content files are OR-ed; all reference numbers within a matched content file are OR-ed."
                },
                "generated": {
                    "type": "boolean"
                },
                "region": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "scale": {
                    "$ref": "#/definitions/numericRange"
                },
                "worldspace": {
                    "$ref": "#/definitions/stringOrStringList"
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "instanceRule": {
            "type": "object",
            "properties": {
                "conditions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/conditionData"
                    },
                    "minItems": 1
                },
                "actions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/instanceAction"
                    },
                    "minItems": 1
                },
                "once": {
                    "type": "boolean",
                    "description": "Whether to process this rule only once per object."
                }
            },
            "required": [
                "actions"
            ],
            "additionalProperties": false
        }
    },
    "properties": {
        "log_name": {
            "type": "string",
            "description": "Optional name for logging purposes"
        },
        "replace_names": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "description": "Optional list of cell names to replace objects within. If replace_names, exterior_cells, and replace_regions are all omitted from a static module, replace_meshes applies in every cell."
        },
        "exterior_cells": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/exteriorGrid"
            },
            "minItems": 1,
            "description": "Optional list of exterior cell coordinates to replace objects in. If exterior_cells, replace_names, and replace_regions are all omitted from a static module, replace_meshes applies in every cell."
        },
        "replace_regions": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "description": "Optional list of exact, case-insensitive cell region IDs/names to replace objects within. Region filters are ORed with replace_names and exterior_cells."
        },
        "ignore_records": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/recordId"
            },
            "minItems": 1,
            "description": "List of records to ignore when replacing objects for this module"
        },
        "replace_meshes": {
            "$ref": "#/definitions/replacementMap",
            "description": "Mapping of old mesh paths to replacement mesh paths. With no replace_names, exterior_cells, or replace_regions filters, this mapping is unconditional and applies in every cell."
        },
        "instances": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/instanceRule"
            },
            "minItems": 1,
            "description": "Ordered rules for specific object replacement or transformation"
        }
    },
    "oneOf": [
        {
            "required": [
                "instances"
            ],
            "not": {
                "anyOf": [
                    {
                        "required": [
                            "replace_names"
                        ]
                    },
                    {
                        "required": [
                            "exterior_cells"
                        ]
                    },
                    {
                        "required": [
                            "replace_regions"
                        ]
                    },
                    {
                        "required": [
                            "replace_meshes"
                        ]
                    },
                    {
                        "required": [
                            "ignore_records"
                        ]
                    }
                ]
            }
        },
        {
            "required": [
                "replace_meshes"
            ],
            "not": {
                "required": [
                    "instances"
                ]
            }
        }
    ],
    "additionalProperties": false,
    "examples": [
        {
            "log_name": "Example static module",
            "replace_names": [
                "suran"
            ],
            "exterior_cells": [
                {
                    "x": 6,
                    "y": -7
                }
            ],
            "replace_regions": [
                "ascadian isles region"
            ],
            "replace_meshes": {
                "x/ex_hlaalu_b_01.nif": "my_mod/ex_hlaalu_b_01.nif"
            }
        },
        {
            "log_name": "Example unconditional static module",
            "replace_meshes": {
                "x/common_mesh.nif": "my_mod/common_mesh.nif"
            }
        },
        {
            "log_name": "Example instance module",
            "instances": [
                {
                    "conditions": [
                        {
                            "content_file": "Morrowind.esm"
                        },
                        {
                            "ref_num": 67647
                        }
                    ],
                    "once": true,
                    "actions": [
                        {
                            "replace": {
                                "dremora": 0.25,
                                "dremora_special_fyr": 0.01,
                                "dremora_gothren_guard2": 0.33
                            }
                        },
                        {
                            "transform": {
                                "scale": 1.5,
                                "rotate": {
                                    "z": 90
                                },
                                "position": {
                                    "x": {
                                        "min": -32,
                                        "max": 32
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
