{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Static Switcher Module",
    "type": "object",
    "definitions": {
        "recordId": {
            "type": "string"
        },
        "numericRange": {
            "oneOf": [
                {
                    "type": "number",
                    "description": "Fixed numeric value"
                },
                {
                    "type": "object",
                    "properties": {
                        "min": {
                            "type": "number",
                            "description": "Optional minimum value"
                        },
                        "max": {
                            "type": "number",
                            "description": "Required maximum value"
                        }
                    },
                    "required": [
                        "max"
                    ],
                    "additionalProperties": false,
                    "description": "Random range with optional lower bound"
                }
            ]
        },
        "vector3Range": {
            "type": "object",
            "properties": {
                "x": {
                    "$ref": "#/definitions/numericRange"
                },
                "y": {
                    "$ref": "#/definitions/numericRange"
                },
                "z": {
                    "$ref": "#/definitions/numericRange"
                }
            },
            "additionalProperties": false
        },
        "exteriorGrid": {
            "type": "object",
            "properties": {
                "x": {
                    "type": "integer"
                },
                "y": {
                    "type": "integer"
                }
            },
            "required": [
                "x",
                "y"
            ],
            "additionalProperties": false
        },
        "replacementMap": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "string"
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "replaceAction": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "transformAction": {
            "type": "object",
            "properties": {
                "scale": {
                    "$ref": "#/definitions/numericRange"
                },
                "rotate": {
                    "$ref": "#/definitions/vector3Range"
                },
                "position": {
                    "$ref": "#/definitions/vector3Range"
                },
                "transform_type": {
                    "type": "string",
                    "enum": [
                        "relative",
                        "absolute"
                    ],
                    "default": "relative",
                    "description": "Whether transformations should be applied relative to existing values (default) or as absolute replacements"
                }
            },
            "additionalProperties": false
        },
        "instanceAction": {
            "type": "object",
            "oneOf": [
                {
                    "properties": {
                        "replace": {
                            "$ref": "#/definitions/replaceAction"
                        }
                    },
                    "required": [
                        "replace"
                    ],
                    "additionalProperties": false
                },
                {
                    "properties": {
                        "transform": {
                            "$ref": "#/definitions/transformAction"
                        }
                    },
                    "required": [
                        "transform"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "carryingCount": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "carryingCondition": {
            "oneOf": [
                {
                    "$ref": "#/definitions/recordId"
                },
                {
                    "$ref": "#/definitions/carryingCount"
                }
            ]
        },
        "stringOrStringList": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                }
            ]
        },
        "numberOrNumberList": {
            "oneOf": [
                {
                    "type": "number"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "number"
                    },
                    "minItems": 1
                }
            ]
        },
        "exteriorGridList": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/exteriorGrid"
            },
            "minItems": 1,
            "description": "One or more exterior grid coordinates. This must be an array because table-valued condition payloads are treated as OR-lists by the loader."
        },
        "carryingConditionValue": {
            "oneOf": [
                {
                    "$ref": "#/definitions/recordId"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/carryingCondition"
                    },
                    "minItems": 1
                }
            ]
        },
        "conditionData": {
            "type": "object",
            "properties": {
                "carrying": {
                    "$ref": "#/definitions/carryingConditionValue"
                },
                "cell": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "coords": {
                    "$ref": "#/definitions/exteriorGridList"
                },
                "content_file": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "exterior": {
                    "type": "boolean"
                },
                "name": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "mesh": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "object_type": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "record_id": {
                    "$ref": "#/definitions/stringOrStringList"
                },
                "ref_num": {
                    "$ref": "#/definitions/numberOrNumberList"
                },
                "region": {
                    "$ref": "#/definitions/stringOrStringList"
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "instanceRule": {
            "type": "object",
            "properties": {
                "conditions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/conditionData"
                    },
                    "minItems": 1
                },
                "actions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/instanceAction"
                    },
                    "minItems": 1
                },
                "once": {
                    "type": "boolean",
                    "description": "Whether to process this rule only once per object."
                }
            },
            "required": [
                "actions"
            ],
            "additionalProperties": false
        }
    },
    "properties": {
        "log_name": {
            "type": "string",
            "description": "Optional name for logging purposes"
        },
        "replace_names": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "description": "Optional list of cell names to replace objects within. If replace_names, exterior_cells, and replace_regions are all omitted from a static module, replace_meshes applies in every cell."
        },
        "exterior_cells": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/exteriorGrid"
            },
            "minItems": 1,
            "description": "Optional list of exterior cell coordinates to replace objects in. If exterior_cells, replace_names, and replace_regions are all omitted from a static module, replace_meshes applies in every cell."
        },
        "replace_regions": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "description": "Optional list of exact, case-insensitive cell region IDs/names to replace objects within. Region filters are ORed with replace_names and exterior_cells."
        },
        "ignore_records": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/recordId"
            },
            "minItems": 1,
            "description": "List of records to ignore when replacing objects for this module"
        },
        "replace_meshes": {
            "$ref": "#/definitions/replacementMap",
            "description": "Mapping of old mesh paths to replacement mesh paths. With no replace_names, exterior_cells, or replace_regions filters, this mapping is unconditional and applies in every cell."
        },
        "instances": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/instanceRule"
            },
            "minItems": 1,
            "description": "Ordered rules for specific object replacement or transformation"
        }
    },
    "oneOf": [
        {
            "required": [
                "instances"
            ],
            "not": {
                "anyOf": [
                    {
                        "required": [
                            "replace_names"
                        ]
                    },
                    {
                        "required": [
                            "exterior_cells"
                        ]
                    },
                    {
                        "required": [
                            "replace_regions"
                        ]
                    },
                    {
                        "required": [
                            "replace_meshes"
                        ]
                    },
                    {
                        "required": [
                            "ignore_records"
                        ]
                    }
                ]
            }
        },
        {
            "required": [
                "replace_meshes"
            ],
            "not": {
                "required": [
                    "instances"
                ]
            }
        }
    ],
    "additionalProperties": false,
    "examples": [
        {
            "log_name": "Example static module",
            "replace_names": [
                "suran"
            ],
            "exterior_cells": [
                {
                    "x": 6,
                    "y": -7
                }
            ],
            "replace_regions": [
                "ascadian isles region"
            ],
            "replace_meshes": {
                "x/ex_hlaalu_b_01.nif": "my_mod/ex_hlaalu_b_01.nif"
            }
        },
        {
            "log_name": "Example unconditional static module",
            "replace_meshes": {
                "x/common_mesh.nif": "my_mod/common_mesh.nif"
            }
        },
        {
            "log_name": "Example instance module",
            "instances": [
                {
                    "conditions": [
                        {
                            "content_file": "Morrowind.esm"
                        },
                        {
                            "ref_num": 67647
                        }
                    ],
                    "once": true,
                    "actions": [
                        {
                            "replace": {
                                "dremora": 0.25,
                                "dremora_special_fyr": 0.01,
                                "dremora_gothren_guard2": 0.33
                            }
                        },
                        {
                            "transform": {
                                "scale": 1.5,
                                "rotate": {
                                    "z": 90
                                },
                                "position": {
                                    "x": {
                                        "min": -32,
                                        "max": 32
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
